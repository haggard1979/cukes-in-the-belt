<?xml version="1.0" encoding="UTF-8" ?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <groupId>at.tbloder</groupId>
  <artifactId>cukes-in-the-belt-parent</artifactId>
  <packaging>pom</packaging>
  <version>1.1.0-SNAPSHOT</version>

  <name>Cukes in the Belt Parent</name>
  <url>https://github.com/haggard1979/cukes-in-the-belt</url>

  <description>
    Cukes in the Belt runs Cucumber features inside Jakarta EE containers
    using Arquillian and JUnit 5. Based on Cukes in Space! (CukeSpace).
  </description>

  <modules>
    <module>core</module>
    <module>examples-tomee</module>
    <module>examples-weld</module>
    <module>examples-wildfly</module>
    <module>coverage</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>21</maven.compiler.release>

    <!-- dependency versions -->
    <cucumber.version>8.0.4</cucumber.version>
    <arquillian.version>1.10.2.Final</arquillian.version>
    <junit.version>5.14.4</junit.version>
    <jakartaee.version>10.0.0</jakartaee.version>
    <tomee.version>10.2.0</tomee.version>
    <arquillian-weld-embedded.version>4.0.1.Final</arquillian-weld-embedded.version>
    <weld.version>6.0.4.Final</weld.version>
    <wildfly.version>42.0.0.Final</wildfly.version>
    <wildfly-arquillian.version>5.1.0.Final</wildfly-arquillian.version>

    <!-- plugin versions -->
    <maven-compiler.version>3.16.0</maven-compiler.version>
    <maven-surefire.version>3.6.1</maven-surefire.version>
    <maven-jar.version>3.5.1</maven-jar.version>
    <maven-war.version>3.5.1</maven-war.version>
    <maven-resources.version>3.5.0</maven-resources.version>
    <maven-install.version>3.2.0</maven-install.version>
    <maven-deploy.version>3.2.0</maven-deploy.version>
    <maven-dependency.version>3.11.0</maven-dependency.version>
    <jacoco.version>0.8.16</jacoco.version>
    <maven-source.version>3.4.0</maven-source.version>
    <maven-javadoc.version>3.12.0</maven-javadoc.version>
    <maven-gpg.version>3.2.8</maven-gpg.version>
    <central-publishing.version>0.12.0</central-publishing.version>
    <versions-maven.version>2.23.0</versions-maven.version>

    <!-- code quality -->
    <errorprone.version>2.51.0</errorprone.version>
  </properties>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/license/mit</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>haggard1979</id>
      <name>Thomas Bloder</name>
      <url>https://github.com/haggard1979</url>
    </developer>
  </developers>

  <contributors>
    <contributor>
      <name>Logan McGrath</name>
      <roles>
        <role>author of Cukes in Space!</role>
      </roles>
    </contributor>
    <contributor>
      <name>Romain Manni-Bucau</name>
      <roles>
        <role>maintainer of Cukes in Space!</role>
      </roles>
    </contributor>
  </contributors>

  <scm>
    <connection>scm:git:https://github.com/haggard1979/cukes-in-the-belt.git</connection>
    <developerConnection>scm:git:https://github.com/haggard1979/cukes-in-the-belt.git</developerConnection>
    <url>https://github.com/haggard1979/cukes-in-the-belt</url>
    <tag>HEAD</tag>
  </scm>

  <issueManagement>
    <system>GitHub</system>
    <url>https://github.com/haggard1979/cukes-in-the-belt/issues</url>
  </issueManagement>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.cucumber</groupId>
        <artifactId>cucumber-bom</artifactId>
        <version>${cucumber.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.jboss.arquillian</groupId>
        <artifactId>arquillian-bom</artifactId>
        <version>${arquillian.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>jakarta.platform</groupId>
        <artifactId>jakarta.jakartaee-api</artifactId>
        <version>${jakartaee.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven-compiler.version}</version>
          <configuration>
            <parameters>true</parameters>
            <showWarnings>true</showWarnings>
            <compilerArgs>
              <!-- every javac lint warning fails the build (processing: Error Prone runs as plugin) -->
              <arg>-Xlint:all,-processing</arg>
              <arg>-Werror</arg>
              <!-- Error Prone: bug patterns at compile time, its warnings fail the build too -->
              <arg>-XDcompilePolicy=simple</arg>
              <arg>-XDaddTypeAnnotationsToSymbol=true</arg>
              <arg>--should-stop=ifError=FLOW</arg>
              <arg>-Xplugin:ErrorProne</arg>
            </compilerArgs>
            <annotationProcessorPaths>
              <path>
                <groupId>com.google.errorprone</groupId>
                <artifactId>error_prone_core</artifactId>
                <version>${errorprone.version}</version>
              </path>
            </annotationProcessorPaths>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven-surefire.version}</version>
          <configuration>
            <trimStackTrace>false</trimStackTrace>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>${maven-jar.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-war-plugin</artifactId>
          <version>${maven-war.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-resources-plugin</artifactId>
          <version>${maven-resources.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-install-plugin</artifactId>
          <version>${maven-install.version}</version>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>versions-maven-plugin</artifactId>
          <version>${versions-maven.version}</version>
        </plugin>
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>${jacoco.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-dependency-plugin</artifactId>
          <version>${maven-dependency.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-deploy-plugin</artifactId>
          <version>${maven-deploy.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <profiles>
    <!--
      Publication to Maven Central (Central Portal), see RELEASING.md:
      mvn -Prelease deploy
      Needs the server "central" (Portal user token) in settings.xml and the
      GPG key in MAVEN_GPG_KEY / MAVEN_GPG_PASSPHRASE.
    -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>${maven-source.version}</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>${maven-javadoc.version}</version>
            <configuration>
              <quiet>true</quiet>
              <failOnWarnings>true</failOnWarnings>
              <!-- syntax, HTML and references are checked; not every getter needs a comment -->
              <doclint>all,-missing</doclint>
            </configuration>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>${maven-gpg.version}</version>
            <configuration>
              <!-- key and passphrase from the environment (MAVEN_GPG_KEY, MAVEN_GPG_PASSPHRASE), no gpg binary needed -->
              <signer>bc</signer>
            </configuration>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>${central-publishing.version}</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <autoPublish>true</autoPublish>
              <waitUntil>validated</waitUntil>
              <deploymentName>Cukes in the Belt ${project.version}</deploymentName>
              <!-- published: cukes-in-the-belt-parent and cukes-in-the-belt-core -->
              <excludeArtifacts>
                <artifact>cukes-in-the-belt-examples-tomee</artifact>
                <artifact>cukes-in-the-belt-examples-weld</artifact>
                <artifact>cukes-in-the-belt-examples-wildfly</artifact>
                <artifact>cukes-in-the-belt-coverage</artifact>
              </excludeArtifacts>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

</project>
